DEV_8085_LOGIN=http://10.100.6.24:8085/login-general

DEV_8086_API=http://10.100.6.24
DEV_8086_LOGIN=http://10.100.6.24:8086/login-general

DEV_8087_API=http://10.100.6.24
DEV_8087_LOGIN=http://10.100.6.24:8087/login-general

DEV_8088_API=http://10.100.6.24
