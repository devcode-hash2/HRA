# ============================================
# CONFIGURACIÓN DE SERVIDORES WINDOWS
# ============================================
# NOTA: Este archivo NO usa dotenv-expand
# Las URLs deben escribirse completas (sin ${VAR})
# ============================================

# Nombre de la aplicación
APP_NAME=login-general
# Ruta de login
LOGIN_PATH=login-general

# ============================================
# SERVIDOR DE DESARROLLO (10.100.6.24)
# Carpetas IIS configuradas: app_80, app_8080-app_8089
# ============================================
DEV_SERVER_HOST="10.100.6.24"
DEV_SERVER_PORT="22"
DEV_SERVER_USER="havel.contreras"
DEV_SERVER_PASS="HRA_code-$2023"
DEV_REMOTE_PATH="C:/inetpub/wwwroot/app_80/login-general"
DEV_FOLDERS="80,8080,8081,8082,8083,8084,8085,8086,8087,8088,8089"

# ============================================
# SERVIDOR DE CALIDAD/STAGING (10.100.6.22)
# ============================================
STAGING_SERVER_HOST="10.100.6.22"
STAGING_SERVER_PORT="22"
STAGING_SERVER_USER="admin"
STAGING_SERVER_PASS="tu_contraseña_calidad"
STAGING_REMOTE_PATH="C:/inetpub/wwwroot/app_hra/login-general"

# ============================================
# SERVIDOR DE PRODUCCIÓN (172.16.3.94)
# ============================================
PROD_SERVER_HOST="172.16.3.94"
PROD_SERVER_PORT="22"
PROD_SERVER_USER="admin"
PROD_SERVER_PASS="tu_contraseña_prod"
PROD_REMOTE_PATH="C:/inetpub/wwwroot/app_hra/login-general"

# ============================================
# CONFIGURACIÓN DE URLs POR ENTORNO
# ============================================

# URLs para entornos de desarrollo (10.100.6.24)
# IMPORTANTE: Las URLs de API son solo la IP base, sin puerto ni /api
# Las URLs de LOGIN incluyen el puerto específico para cada entorno
DEV_80_API=http://10.100.6.24
DEV_80_LOGIN=http://10.100.6.24/login-general

DEV_8080_API=http://10.100.6.24
DEV_8080_LOGIN=http://10.100.6.24:8080/login-general

DEV_8081_API=http://10.100.6.24
DEV_8081_LOGIN=http://10.100.6.24:8081/login-general

DEV_8082_API=http://10.100.6.24
DEV_8082_LOGIN=http://10.100.6.24:8082/login-general

DEV_8083_API=http://10.100.6.24
DEV_8083_LOGIN=http://10.100.6.24:8083/login-general

DEV_8084_API=http://10.100.6.24
DEV_8084_LOGIN=http://10.100.6.24:8084/login-general

